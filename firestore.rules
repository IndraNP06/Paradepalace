rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Collection: Users
    // Users can read/write their own profile. Admins can read all.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin(); // Should be restricted more in robust apps (e.g. deny role change)
    }

    // Collection: Team Members (Public Read, Admin Write)
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: Gallery Items (Public Read, Admin Write)
    match /gallery_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: Settings (Public Read, Admin Write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
